# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_single_window_compare
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Single Window Compare
description: >
 This project demonstrates using the IADC peripheral as a window comparator on a single-ended input. The window comparator is configured to trigger on output results which are inside the specified window.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: emlib_iadc
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EM01GRPACLK_SOURCE"
    value: "CMU_EM01GRPACLKCTRL_CLKSEL_HFXO"
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_EM01GRPACLK"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
  