# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_single_calibration
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Single Calibration
description: >
 This project demonstrates how to use the IADC and an external supply to calibrate gain and offset. It also shows how to perform repeated blocking differential measurements on a single set of differential inputs and store both raw results and voltage values in global variables.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: emlib_iadc
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  