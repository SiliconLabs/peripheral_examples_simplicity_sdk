# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_scan_gpio_prs_ldma
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Scan GPIO PRS LDMA
description: >
  This project demonstrates use of the IADC to take single-ended analog measurements using two external inputs, triggered via the PRS in response to a positive (rising) edge on a user-specified GPIO pin.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_iadc
  - id: emlib_prs
  - id: hal_ldma
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
define:
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2026_6