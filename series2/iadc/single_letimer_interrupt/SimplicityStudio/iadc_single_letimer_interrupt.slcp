# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_single_letimer_interrupt
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Single LETIMER Interrupt
description: >
  This project demonstrates using the IADC peripheral to take single-ended analog measurements using a single external input, triggered periodically by  LETIMER underflow interrupt.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_iadc
  - id: emlib_letimer
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
  - name: "SL_CLOCK_MANAGER_EM23GRPACLK_SOURCE"
    value: "CMU_EM23GRPACLKCTRL_CLKSEL_LFXO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  