# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_scan_iadc_timer
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Scan IADC Timer
description: >
  This project demonstrates use of the IADC to take single-ended analog analog measurements of two input channels.  The IADC operates in EM0 with its local timer triggering scan sequences.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: emlib_iadc
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EM01GRPACLK_SOURCE"
    value: "CMU_EM01GRPACLKCTRL_CLKSEL_HFXO"
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_EM01GRPACLK"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  