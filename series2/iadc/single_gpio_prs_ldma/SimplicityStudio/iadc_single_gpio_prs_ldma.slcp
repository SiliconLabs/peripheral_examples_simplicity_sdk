# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_single_gpio_prs_ldma
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Single GPIO PRS LDMA
description: >
 This project demonstrates how to use the IADC to take single-ended analog measurements using a single external input, triggered by rising edge of GPIO via PRS. Upon completion, an LDMA data transfer occurs storing the raw data to memory. 
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: power_manager
  - id: clock_manager
  - id: dmadrv
  - id: emlib_iadc
  - id: emlib_prs
  - id: emlib_ldma
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
define:
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2026_6