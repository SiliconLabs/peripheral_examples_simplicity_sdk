# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_scan_letimer_interrupt
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Scan LETIMER Interrupt
description: >
  This project demonstrates use of the IADC to take single-ended analog measurements across two different external inputs and six of the supply voltage input channels.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_iadc
  - id: emlib_letimer
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
  