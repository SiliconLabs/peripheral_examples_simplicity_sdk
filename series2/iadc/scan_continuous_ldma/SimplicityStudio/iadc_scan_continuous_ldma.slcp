# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_scan_continuous_ldma
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Scan Continuous LDMA
description: >
  This project demonstrates use of the IADC to continuously sample two single-ended input channels.  The CPU starts the scan while in EM0, and operation continues in EM2 with the LDMA saving the results to RAM and waking the system with an interrupt request to toggle a GPIO pin.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_iadc
  - id: emlib_ldma
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  