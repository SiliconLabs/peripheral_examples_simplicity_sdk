# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: iadc_single_letimer_prs_ldma
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - IADC Single LETIMER PRS DMA
description: >
  This project demonstrates use of the IADC to take single-ended analog measurements on a single channel from a periodic PRS trigger input. Operation is in EM2 with once per second underflows of the LETIMER triggering conversions of the selected channel and the LDMA saving the result and requesting an interrupt after the specified number of transfers.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_iadc
  - id: emlib_letimer
  - id: emlib_prs
  - id: hal_ldma
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_FSRCO"
  - name: "SL_CLOCK_MANAGER_EM23GRPACLK_SOURCE"
    value: "CMU_EM23GRPACLKCTRL_CLKSEL_LFXO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
define:
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2026_6