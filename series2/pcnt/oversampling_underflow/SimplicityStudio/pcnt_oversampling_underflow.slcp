# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: pcnt_oversampling_underflow
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - PCNT Oversampling Underflow
description: >
    This project demonstrates the single input oversampling mode of the pulse down-counter with interrupts.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
- id: sl_main
- id: silabs_bsp
  from: peripheral_examples
- id: clock_manager
- id: power_manager
- id: device_init
- id: emlib_pcnt
- id: emlib_prs
sdk_extension:
 - id: peripheral_examples
   version: 1.0.0
