# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: pcnt_oversampling_quadrature
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - PCNT Oversampling Quadrature
description: >
    This project demonstrates the oversampling quadrature decoder mode of the pulse counter peripheral.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: clock_manager
  - id: power_manager
  - id: device_init
  - id: emlib_pcnt
  - id: emlib_prs
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
