# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: i2c_leader_dma
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - I2C Leader DMA
description: >
  This project demonstrates I2C leader operation in conjunction with LDMA
  so that the host CPU can be freed to perform other tasks while data is
  being moved to and from the follower device.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: power_manager_no_deepsleep
  - id: emlib_i2c
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_HFRCO_BAND"
    value: "cmuHFRCODPLLFreq_19M0Hz"
  - name: "SL_CLOCK_MANAGER_HFXO_EN"
    value: "SL_CLOCK_MANAGER_HFXO_EN_DISABLE"
  - name: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL"
  - name: "SL_CLOCK_MANAGER_SYSCLK_SOURCE"
    value: "CMU_SYSCLKCTRL_CLKSEL_HFRCODPLL"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  