# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: etampdet_em4
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ETAMPDET EM4
description: >
  This project demonstrates the tamper detection module available on EFR32xG25 and EFR32xG27.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: interrupt_manager
  - id: power_manager_deepsleep
  - id: emlib_rmu
  - id: power_manager
  - id: emlib_burtc
  - id: sl_sleeptimer
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
configuration:
  - name: "SL_POWER_MANAGER_INIT_EMU_EM4_PIN_RETENTION_MODE"
    value: "EMU_EM4CTRL_EM4IORETMODE_SWUNLATCH"
  - name: "SL_CLOCK_MANAGER_EM4GRPACLK_SOURCE"
    value: "CMU_EM4GRPACLKCTRL_CLKSEL_LFXO"
