# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: emu_em1_dcdc
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EMU EM1 DCDC
description: >
  This project demonstrates the datasheet current consumption configuration and current consumption numbers in EM1 Energy Mode.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: power_manager_no_deepsleep
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
configuration:
  - name: "SL_CLOCK_MANAGER_HFXO_EN"
    value: "SL_CLOCK_MANAGER_HFXO_EN_DISABLE"
  - name: "SL_CLOCK_MANAGER_LFXO_EN"
    value: "0"
  - name: "SL_CLOCK_MANAGER_HFRCO_BAND"
    value: "cmuHFRCODPLLFreq_38M0Hz"
  - name: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL"
  - name: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFRCO"