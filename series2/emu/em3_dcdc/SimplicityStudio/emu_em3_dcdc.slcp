# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: emu_em3_dcdc
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EMU EM3 DCDC
description: >
  This project demonstrates the datasheet current consumption configuration and current consumption numbers in EM3 Energy Mode.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_burtc
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
configuration:
  - name: "SL_CLOCK_MANAGER_HFXO_EN"
    value: "SL_CLOCK_MANAGER_HFXO_EN_DISABLE"
  - name: "SL_CLOCK_MANAGER_LFXO_EN"
    value: "0"
  - name: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL"
  - name: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_ULFRCO"
  - name: "SL_POWER_MANAGER_INIT_EMU_EM2_DEBUG_ENABLE"
    value: "0"
  - name: "SL_SLEEPTIMER_PERIPHERAL"
    value: "SL_SLEEPTIMER_PERIPHERAL_BURTC"
  - name: "SL_CLOCK_MANAGER_EM4GRPACLK_SOURCE"
    value: "CMU_EM4GRPACLKCTRL_CLKSEL_ULFRCO"
