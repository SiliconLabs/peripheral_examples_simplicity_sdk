# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: em4_no_dcdc
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EMU EM4 no DCDC
description: >
  This project demonstrates the datasheet current consumption configuration and current consumption numbers in EM4 Energy Mode.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: emlib_rmu
  - id: emlib_burtc
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
