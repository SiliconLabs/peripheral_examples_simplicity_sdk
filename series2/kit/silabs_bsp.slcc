id: silabs_bsp
package: peripheral_examples
description: >
  Board Support Package
label: Board Support Package
category: BSP
quality: production
provides:
  - name: silabs_bsp
    allow_multiple: false
template_contribution:
  - name: component_catalog
    value: silabs_bsp
