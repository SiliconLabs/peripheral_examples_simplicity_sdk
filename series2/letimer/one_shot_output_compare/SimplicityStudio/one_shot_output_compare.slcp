# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: one_shot_output_compare
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LETIMER One Shot Output Compare
description: >
  This project demonstrates output compare in EM2 using the LETIMER.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_letimer
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
  