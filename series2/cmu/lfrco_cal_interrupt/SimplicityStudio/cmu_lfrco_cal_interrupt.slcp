# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: cmu_lfrco_cal_interrupt
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - CMU LFRCO Calibaration Interrupt 
description: >
  This project demonstrates interrupt-driven calibration of the LFRCO against the HFXO.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: power_manager_no_deepsleep
  - id: emlib_burtc
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
configuration:
  - name: "SL_CLOCK_MANAGER_SYSCLK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE"
  - name: "SL_CLOCK_MANAGER_HFXO_EN"
    value: "SL_CLOCK_MANAGER_HFXO_EN_ENABLE"
  - name: "SL_CLOCK_MANAGER_LFXO_EN"
    value: "0"
  - name: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFXO"
  - name: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE"
    value: "SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFRCO"
  - name: "SL_CLOCK_MANAGER_EM4GRPACLK_SOURCE"
    value: "CMU_EM4GRPACLKCTRL_CLKSEL_LFRCO"
