# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: gpio_periph
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - On-Chip Oscillator To Pin
description: >
  This project demonstrates how to configure a GPIO pin to output the signal from an on-chip oscillator (the LFRCO, in this case) and how to set both the default and alternate slew rates for the chosen GPIO port.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  