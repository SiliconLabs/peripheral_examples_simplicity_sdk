# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: gpio_slew_rate
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - GPIO Slew Rate
description: >
  This project demonstrates how to set the slew rate for GPIO pins. In this example, pressing button PB0 increments the slew rate setting such pressing the button 8 times cycles the through all slew rate settings.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: clock_manager
  - id: power_manager
  - id: power_manager_no_deepsleep
  - id: emlib_timer
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EM01GRPACLK_SOURCE"
    value: "CMU_EM01GRPACLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
  