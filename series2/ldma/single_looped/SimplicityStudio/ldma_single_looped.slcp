# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_single_looped
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA Single Looped
description: >
  In this example, the LDMA transfers 16 words from one software array to another in 4 sets of 4 words. The transfer is requested by software at the end of the LDMA initialization.

category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
  

