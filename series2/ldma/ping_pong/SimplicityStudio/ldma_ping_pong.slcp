# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_ping_pong
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA Ping Pong
description: >
  Software requests LDMA ping-pong transfers. A universal source array is transfered first to the "pingBuffer" array, then to the "pongBuffer", then back to ping, etc. After each transfer, there is an interrupt that increments the elements of the source buffer, then requests the next transfer.
  
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  

