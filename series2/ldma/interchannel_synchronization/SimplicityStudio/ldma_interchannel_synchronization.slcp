# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_interchannel_synchronization
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA Interchannel Synchronization
description: >
  The LDMA synchronizes across 2 Channels, with both channels starting off a different button press to transfer 4-character strings from one software array to another.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: emlib_prs
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  

