# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: acmp_interrupt
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ACMP Interrupt
description: >
  This project demonstrates interrupt-driven use of the ACMP by comparing the voltage on an input pin when a button is pressed to the internal 1.25 V reference (VREF).
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_acmp
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
  