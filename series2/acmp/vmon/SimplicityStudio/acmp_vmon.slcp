# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: acmp_vmon
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ACMP VMON
description: >
  This project shows how the ACMP module and its VSENSE inputs can be used to monitor a supply voltage without CPU intervention.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_acmp
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  