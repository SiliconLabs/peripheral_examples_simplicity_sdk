# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: euart_ldma_em2
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EUART LDMA EM2
description: >
  This project demonstrates low-frequency operation of the EUART using LDMA 
  to receive inbound data and transmit outbound data while remaining in EM2.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_eusart
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EUART0CLK_SOURCE"
    value: "CMU_EUART0CLKCTRL_CLKSEL_EM23GRPACLK"
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  