# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: eusart_async_half_duplex
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EUSART Async Half Duplex
description: >
  This project demonstrates operation of the EUSART in a half-duplex, single link configuration.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: emlib_eusart
  - id: power_manager
  - id: power_manager_no_deepspleep
  - id: interrupt_manager
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EUSART0CLK_SOURCE"
    value: "CMU_EUSART0CLKCTRL_CLKSEL_LFXO"
    unless: [brd4194a, brd4412a]
  - name: "SL_CLOCK_MANAGER_EUSART0CLK_SOURCE"
    value: "CMU_EUSART0CLKCTRL_CLKSEL_EM23GRPACLK"
    condition: [brd4194a, brd4412a]
  - name: "SL_CLOCK_MANAGER_EM23GRPACLK_SOURCE"
    value: "CMU_EM23GRPACLKCTRL_CLKSEL_LFXO"
    condition: [brd4194a, brd4412a]
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
  