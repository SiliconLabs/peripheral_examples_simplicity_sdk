# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: lesense_single_channel
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LESENSE Single Channel
description: >
  This project demonstrates the usage of LESENSE to sample a single channel using ACMP. 
  
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: emlib_acmp
  - id: emlib_iadc
  - id: emlib_lesense
  - id: emlib_gpio
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_EM23GRPACLK_SOURCE"
    value: "CMU_EM23GRPACLKCTRL_CLKSEL_LFRCO"
  - name: "SL_CLOCK_MANAGER_SYSCLK_SOURCE"
    value: "CMU_SYSCLKCTRL_CLKSEL_FSRCO"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
  

