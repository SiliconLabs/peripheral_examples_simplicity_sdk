# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: lesense_multi_channel
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LESENSE Multi Channel
description: >
  This project demonstrates the usage of LESENSE to sample multiple channels using IADC. The project defines four LESENSE channels and each of these channels is linked to one of four IADC scan inputs based on IADC configuration. 
  
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: emlib_acmp
  - id: emlib_iadc
  - id: emlib_ldma
  - id: emlib_lesense
  - id: emlib_gpio
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_CLOCK_MANAGER_HFRCOEM23_BAND"
    value: "cmuHFRCOEM23Freq_1M0Hz"
  - name: "SL_CLOCK_MANAGER_EM23GRPACLK_SOURCE"
    value: "CMU_EM23GRPACLKCTRL_CLKSEL_LFRCO"
  - name: "SL_CLOCK_MANAGER_LESENSEHFCLK_SOURCE"
    value: "CMU_LESENSEHFCLKCTRL_CLKSEL_HFRCOEM23"
  - name: "SL_CLOCK_MANAGER_SYSCLK_SOURCE"
    value: "CMU_SYSCLKCTRL_CLKSEL_FSRCO"
  - name: "SL_POWER_MANAGER_CONFIG_VOLTAGE_SCALING_FAST_WAKEUP"
    value: "0"
  - name: "SL_CLOCK_MANAGER_IADCCLK_SOURCE"
    value: "CMU_IADCCLKCTRL_CLKSEL_HFRCOEM23"
sdk_extension:
  - id: peripheral_examples
    version: 1.1.0
  

