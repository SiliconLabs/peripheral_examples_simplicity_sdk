# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_linked_list_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA Linked List
description: >
  Software requests a LDMA transfer on a linked list of 4 descriptors, which each move 32 halfwords of memory into a destination buffer. There are interrupts triggered after the second and fourth descriptors.
  
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
define:
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2026_6

