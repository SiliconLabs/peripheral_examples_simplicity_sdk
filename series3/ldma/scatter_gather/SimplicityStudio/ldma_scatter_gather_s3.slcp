# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_scatter_gather_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA Scatter Gather
description: >
  Software requests a LDMA transfer on a linked list of 4 descriptors to "scatter" one large array into 4 smaller arrays. Each descriptor moves 8 halfwords of memory into a destination buffer. An interrupt triggers after the completion of the "scatter".

category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
  

