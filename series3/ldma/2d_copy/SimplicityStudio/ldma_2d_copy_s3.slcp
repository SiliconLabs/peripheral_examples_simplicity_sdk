# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: ldma_2d_copy_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - LDMA 2D Copy
description: >
  In this example, the LDMA transfers a submatrix from one software matrix to another. The source buffer is numbered from 0 to (BUFFER_2D_WIDTH * BUFFER_2D_HEIGHT - 1) in row major order.
  
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  

