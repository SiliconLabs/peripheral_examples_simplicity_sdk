# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: pixelrz_ldma_letimer_prs_gpio_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - PIXELRZ Sequential
description: >
  This project demonstrates how to configure the PIXELRZ in sequential mode to drive a WS2812B LED strip.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: silabs_bsp
    from: peripheral_examples
  - id: clock_manager
  - id: interrupt_manager
  - id: dmadrv
  - id: hal_ldma
  - id: hal_letimer
  - id: hal_pixelrz
  - id: hal_prs
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
define:
  - name: SL_SUPPRESS_DEPRECATION_WARNINGS_SDK_2026_6
