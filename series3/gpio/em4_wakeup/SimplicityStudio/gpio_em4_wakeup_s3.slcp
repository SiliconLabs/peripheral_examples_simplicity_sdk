# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: gpio_em4_wakeup_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - GPIO EM4 Wakeup
description: >
     This project uses a GPIO pin to wake the device from EM4.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: hal_emu
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    version: 1.1.0
