# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: adc_single_letimer_prs_ldma_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ADC Single LETIMER PRS LDMA
description: >
  This project demonstrates use of the ADC to take single-ended analog measurements of a single channel, triggered periodically through PRS underflow of LETIMER.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: silabs_bsp
    from: peripheral_examples
  - id: hal_adc
  - id: hal_ldma
  - id: hal_letimer
  - id: hal_prs
  - id: dmadrv
sdk_extension:
  - id: peripheral_examples
    version: 1.1.0
  
