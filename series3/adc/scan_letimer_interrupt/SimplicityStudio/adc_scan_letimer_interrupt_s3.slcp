# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: adc_scan_letimer_interrupt_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ADC Scan LETIMER Interrupt
description: >
  This project demonstrates using the ADC peripheral to take single-ended analog measurements of two external inputs and four internal supply voltage channels, with conversions triggered periodically by LETIMER underflow interrupt.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
  - id: hal_adc
  - id: hal_letimer
  - id: hal_prs
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  
