# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: adc_scan_adc_timer_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - ADC Scan ADC Timer
description: >
  This project demonstrates using the ADC peripheral to take single-ended analog measurements of two external inputs using the ADC local timer to trigger scan sequence. An interrupt is requested when the specified FIFO data valid level is reached, and the conversion results are converted to volts and stored in a global array. A GPIO is toggled during the IADC interrupt handler to signal the end of the most recent scan.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: silabs_bsp
    from: peripheral_examples
  - id: hal_adc
sdk_extension:
  - id: peripheral_examples
    version: 1.0.0
  
