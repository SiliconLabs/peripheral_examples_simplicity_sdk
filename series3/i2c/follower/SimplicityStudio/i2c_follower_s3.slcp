# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: i2c_follower_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - I2C Follower
description: >
  This project demonstrates the follower configuration of the SiMG301 I2C peripheral. Two SiMG301 devices are connected together, one running a leader project, the other running the follower project. The leader reads the follower's current buffer values, increments each value, and writes new values back to the follower device. The leader then reads back the follower values again and verifies that the new values match what was previously written.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager_no_deepsleep
  - id: hal_i2c
  - id: silabs_bsp
    from: peripheral_examples
  - id: silabs_peripheral_config
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.1.0
  
