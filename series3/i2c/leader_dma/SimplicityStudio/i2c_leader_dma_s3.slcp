# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: i2c_leader_dma_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - I2C Leader with LDMA
description: >
  This project demonstrates I2C leader operation in conjunction with LDMA so that the host CPU can be freed to perform other tasks while data is being moved to and from the follower device. Two SiMG301 devices are connected together, one running a leader project, the other running the follower project. The leader reads the follower's current buffer values, increments each value, and writes new values back to the follower device. The leader then reads back the follower values again and verifies that the new values match what was previously written.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager_no_deepsleep
  - id: hal_i2c
  - id: hal_ldma
  - id: dmadrv
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_BOARD_ENABLE_SENSOR_RHT"
    value: "1"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  
