# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: eusart_spi_main_interrupt_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EUSART SPI Main Interrupt
description: >
  This project demonstrates polled operation of the EUSART in synchronous main (formerly master) mode. 
  EUSART0/1 is configured for SPI-compatible operation at 1 Mbps.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: power_manager
  - id: power_manager_no_deepsleep
  - id: hal_eusart
  - id: silabs_bsp
    from: peripheral_examples
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 2.0.0
  
