# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: eusart_async_polled_s3
package: peripheral_examples
quality: evaluation
label: Peripheral Examples - EUSART Async Polled
description: >
  This project demonstrates polled operation of the EUSART in asynchronous mode.
category: Example|Peripheral Examples
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: ../src/app.c
  - path: ../src/main.c
include:
  - path: "../src"
    file_list:
    - path: app.h
readme:
  - path: ../readme.md
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: hal_eusart
  - id: silabs_bsp
    from: peripheral_examples
configuration:
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
  - name: "SL_CLOCK_MANAGER_EUSART0CLK_SOURCE"
    value: "CMU_EUSART0CLKCTRL_CLKSEL_EM01GRPCCLK"
  - name: "SL_CLOCK_MANAGER_EM01GRPCCLK_SOURCE"
    value: "CMU_EM01GRPCCLKCTRL_CLKSEL_HFRCOEM23"
sdk_extension:
  - id: peripheral_examples
    vendor: silabs
    version: 1.1.0
  