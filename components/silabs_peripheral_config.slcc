id: silabs_peripheral_config
package: peripheral_examples
description: >
  Device peripheral configuration
label: Device Peripheral Configuration
category: Peripheral Config
quality: production
provides:
  - name: silabs_peripheral_config
    allow_multiple: false
template_contribution:
  - name: component_catalog
    value: silabs_peripheral_config
metadata:
  sbom:
    license: MSLA
config_file:
  - path: components/series2/EFR32BG27_BRD4111A/peripheral_config.h
    condition: [brd4111a]
  - path: components/series2/EFR32FG25_BRD4270B/peripheral_config.h
    condition: [brd4270b]
  - path: components/series2/EFR32MG21_BRD4181A/peripheral_config.h
    condition: [brd4181a]
  - path: components/series2/EFR32MG22_BRD4182A/peripheral_config.h
    condition: [brd4182a]
  - path: components/series2/EFR32MG24_BRD4186C/peripheral_config.h
    condition: [brd4186c]
  - path: components/series2/EFR32MG26_BRD4117A/peripheral_config.h
    condition: [brd4117a]
  - path: components/series2/EFR32MG27_BRD4194A/peripheral_config.h
    condition: [brd4194a] 
  - path: components/series2/EFR32ZG23_BRD4204D/peripheral_config.h
    condition: [brd4204d]
  - path: components/series2/EFR32ZG28_BRD4400C/peripheral_config.h
    condition: [brd4400c]
  - path: components/series2/EFR32MG29_BRD4412A/peripheral_config.h
